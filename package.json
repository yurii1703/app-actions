{
  "name": "app-actions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite -c yellow,cyan \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "lint": "oxlint src server tests vite.config.js playwright.config.js playwright-ct.config.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "npm run test:components && npm run test:e2e",
    "test:components": "playwright test -c playwright-ct.config.js",
    "test:e2e": "playwright test -c playwright.config.js"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.62.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
